{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentHUD",
  "version": "0.7.0",
  "identifier": "com.agenthud.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "AgentHUD",
        "width": 1120,
        "height": 940,
        "minWidth": 380,
        "minHeight": 48,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; script-src 'self'; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../assets/icon.ico", "../assets/icon.png"],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "../assets/icon.ico"
      }
    }
  }
}
